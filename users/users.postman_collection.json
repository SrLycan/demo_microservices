{
  "info": {
    "name": "users microservice",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Microservicio users: asocia un cognitoId (sub del token de Cognito) con los datos propios del usuario. Todas las rutas /api/** exigen un access_token valido de Cognito. Pega el access_token en la variable de coleccion {{token}}."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8888/users"
    },
    {
      "key": "token",
      "value": "eyJraWQiOiJ5N3VuVFdhYlQ5cFZmOVFMNDVFN01jSlFnVUJQekRsVEVmZGQyS2kvQW9JPSIsImFsZyI6IlJTMjU2In0..cs321av6mwSOchof8NsUVgpx7TF9ONT2dEx04x6cxCJ-NV3czXNEp_lERk1BFCZdOH_UjB00qIJBikur-b__n9sjwDGG5yDAi2Uevi0P3yPejNCqP21GBN3s4O4YbLlmp1f8uNs1wDbd69zmH_w0TEzAfdp-_7Ou_e0I94SvuRRZOtn-FldEdAk63zmYBGTMcPzwh2TQQtNl5hEnXUSrZE12_wkQmZooAjXkke-ilcLeaiAJZZolUAh_GO8WhOO-5770lZofaAYhR3LsgXedxZ_RGbpBbr9zejx0UC2-hm1Oa73AE2HsS6nj4SjVmTRzAzOhin3NKA2KVq899Uib-A"
    }
  ],
  "item": [
    {
      "name": "01 - crear mi perfil (POST /me)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Ana Lopez\",\n    \"email\": \"ana@puce.edu\",\n    \"phone\": \"0999999999\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/users/me",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "me"]
        },
        "description": "El cognitoId NO va en el body: se toma del claim 'sub' del token. Asocia tu perfil a tu usuario de Cognito."
      },
      "response": []
    },
    {
      "name": "02 - ver mi perfil (GET /me)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/me",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Devuelve los datos propios asociados al usuario autenticado (segun el sub del token)."
      },
      "response": []
    },
    {
      "name": "03 - actualizar mi perfil (PUT /me)",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Ana Maria Lopez\",\n    \"email\": \"anamaria@puce.edu\",\n    \"phone\": \"0988888888\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/users/me",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "me"]
        }
      },
      "response": []
    },
    {
      "name": "04 - listar todos (GET /api/users)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users",
          "host": ["{{base_url}}"],
          "path": ["api", "users"]
        }
      },
      "response": []
    },
    {
      "name": "05 - buscar por id (GET /api/users/{id})",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/1",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "1"]
        }
      },
      "response": []
    },
    {
      "name": "06 - buscar por cognitoId (GET /api/users/cognito/{cognitoId})",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/cognito/PEGA_AQUI_UN_COGNITO_ID",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "cognito", "PEGA_AQUI_UN_COGNITO_ID"]
        },
        "description": "Consulta directa por cognitoId. Util para que OTROS microservicios resuelvan un sub a un perfil."
      },
      "response": []
    },
    {
      "name": "07 - eliminar (DELETE /api/users/{id})",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/1",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "1"]
        }
      },
      "response": []
    },
    {
      "name": "08 - sin token -> 401 (demo)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/me",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Sin Authorization: Bearer el resource server responde 401 Unauthorized. Demuestra la autenticacion."
      },
      "response": []
    }
  ]
}
